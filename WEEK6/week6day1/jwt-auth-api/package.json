{
  "name": "jwt-auth-api",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Express + TypeScript REST API starter for practicing JWT authentication",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
